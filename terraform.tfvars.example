# GCP Project Configuration
project_id = "your-gcp-project-id"

# Availability type: ZONAL (single-zone) or REGIONAL (high availability)
availability_type = "ZONAL"
region            = "asia-northeast1"
zone              = "asia-northeast1-a"

# Dify Configuration
dify_version = "1.13.0"

# =============================================================================
# Network Configuration
# =============================================================================

# SSL Configuration
# Option 1: Use a domain name for Google-managed SSL certificate
domain_name = "dify.example.com"

# Option 2: Use self-signed certificate (if domain_name is empty)
# ssl_certificate = file("path/to/certificate.pem")
# ssl_private_key = file("path/to/private-key.pem")

# =============================================================================
# VM Instance Configuration
# =============================================================================

machine_type = "e2-standard-8"
disk_size_gb = 50

# =============================================================================
# Cloud SQL Configuration
# =============================================================================

# Cloud SQL Configuration
cloudsql_tier      = "db-custom-4-16384"
cloudsql_disk_size = 50

# =============================================================================
# pgvector Configuration
# =============================================================================

# Cloud SQL Configuration
pgvector_tier      = "db-custom-4-16384"
pgvector_disk_size = 100

# =============================================================================
# Filestore Configuration
# =============================================================================
# BASIC_HDD/BASIC_SSD tiers require zone
# HIGH_SCALE_SSD/ENTERPRISE tiers support zone or region
# =============================================================================

# Filestore tier: BASIC_HDD, BASIC_SSD, HIGH_SCALE_SSD, or ENTERPRISE
filestore_tier = "BASIC_HDD"

# Filestore capacity in GB (minimum 1024 GB for BASIC_HDD, 2560 GB for BASIC_SSD)
filestore_capacity_gb = 1024

# =============================================================================
# Memorystore for Redis Configuration
# =============================================================================

# Redis tier: BASIC (standalone) or STANDARD_HA (high availability)
redis_tier = "BASIC"

# Redis memory size in GB (1-300)
redis_memory_size_gb = 10

# Enable Redis AUTH (password authentication) - recommended for production
redis_auth_enabled = true
